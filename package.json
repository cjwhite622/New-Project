{
  "name": "the-hub",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "A local-first business hub with governed AI agents",
  "main": "electron/main.cjs",
  "author": "The Hub",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:desktop": "node tests/desktop.mjs",
    "test:desktop:windows": "node tests/windows-desktop.mjs",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && node scripts/package-windows.mjs",
    "package:portable": "node scripts/package-portable.mjs",
    "package:linux": "npm run build && electron-builder --linux dir --x64",
    "release:source": "node scripts/source-release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "fflate": "^0.8.3",
    "playwright-core": "^1.55.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "local.thehub.desktop",
    "productName": "The Hub",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "config/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": "dir",
      "icon": "build/icon.png",
      "category": "Office"
    }
  }
}
